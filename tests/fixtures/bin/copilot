#!/usr/bin/env node
// Stand-in Copilot CLI in its stream JSON shape, so the reviewer path can be driven without
// spending the real one. Answers --version for connection detection. In a project folder Zenith
// drives Copilot over ACP, which the test ACP agent answers by echoing the prompt.
const args = process.argv.slice(2);
if (args.includes("--version")) { console.log("1.0.80"); process.exit(0); }
if (args.includes("--acp")) {
  await import(new URL("../fake-acp-agent.mjs", import.meta.url).href);
} else {
  const out = (m) => process.stdout.write(`${JSON.stringify(m)}\n`);
  const reply =
    "VERDICT: findings\n\n- SEVERITY: high\n  WHERE: leak.ts:1\n  PROBLEM: An API key is committed in the source.\n  FIX: Read it from the environment instead.";
  for (const piece of reply.match(/.{1,30}/gs) ?? []) {
    out({ type: "assistant.message_delta", data: { deltaContent: piece } });
  }
  out({ type: "assistant.usage", data: { inputTokens: 900, outputTokens: 60 } });
}
