{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "lib": ["ES2023"],
    "noEmit": false,
    "outDir": ".types/preload",
    "rootDir": "src",
    "tsBuildInfoFile": ".types/preload.tsbuildinfo",
    "types": ["electron"]
  },
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts"]
}
